    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'exp-componet'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=exp-componet"
                ]
            },
            "args": [
                "C:\\dir_dev\\This game .mp3",
                "C:\\dir_dev\\today.mp3",
                "C:\\dir_dev\\taking my heart.mp3",
            ],
            "initCommands": [
                "breakpoint set --name core::panicking::panic_fmt",
                "breakpoint set --name core::panicking::panic_nounwind_fmt"
            ]
        },
        {
            "name": "Debug unit tests in executable 'exp-componet'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=exp-componet"
                ]
            }
        }
    ]
}