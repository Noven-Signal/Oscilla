    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'Oscilla'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=Oscilla"
                ]
            },
            "args": [
            ],
            "env": {
                "log_dir": "log"
            },
            "initCommands": [
                "breakpoint set --name core::panicking::panic_fmt",
                "breakpoint set --name core::panicking::panic_nounwind_fmt"
            ]
        },
        {
            "name": "Debug unit tests in executable 'Oscilla'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=Oscilla"
                ]
            }
        }
    ]
}